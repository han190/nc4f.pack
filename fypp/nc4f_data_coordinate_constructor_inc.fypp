#: include 'common.fypp'
interface coordinate_type
  #: for K in kinds
    #: for R in range(1, MAX_RANK+1)
  module procedure :: new_coord_${K}$_${R}$d
    #: endfor
  #: endfor
end interface coordinate_type

interface
  #: for T, K in zip(types, kinds)
    #: for R in range(1, MAX_RANK+1)
  module function new_coord_${K}$_${R}$d(name, values, dims, atts) &
    & result(coord)
    character(len=*), intent(in) :: name
      #: if R >= 13
    ${T}$(${K}$), intent(in) :: values(${COLONS(10)}$, &
      & ${COLONS(R-10)}$)
      #: else
    ${T}$(${K}$), intent(in) :: values(${COLONS(R)}$)
      #: endif
    type(dimension_type), intent(in) :: dims(:)
    type(attribute_type), intent(in), optional :: atts(:)
    type(coordinate_type) :: coord
  end function new_coord_${K}$_${R}$d${NEWLINE(not (K == 'real64' and R == MAX_RANK))}$
    #: endfor
  #: endfor
end interface
