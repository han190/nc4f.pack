#: include 'common.fypp'
submodule(module_netcdf) submodule_variable_constructor
implicit none (type, external)
contains${newline}$
#: for N, T, K, C in zip(nc_types, types, kinds, ckinds)
#: for R in range(1, MAX_RANK+1)
module function new_variable_${K}$_${R}$d(name, values, dims, atts) result(var)
  character(len=*), intent(in) :: name
  ${T}$(${K}$), target, intent(in) :: values(${COLONS(R)}$)
  type(dimension_type), intent(in) :: dims(:)
  type(attribute_type), intent(in), optional :: atts(:)
  type(variable_type), target :: var
  ${T}$(${C}$), pointer :: var_ptr(${COLONS(R)}$)

  call new_variable_(var, name, ${N}$, size(values, kind=int64), dims)
  call allocate_buffer(var)
  call extract(var, var_ptr)
  var_ptr = values
  nullify (var_ptr)
  if (present(atts)) var%attributes = atts
end function new_variable_${K}$_${R}$d${newline}$
#: endfor
#: endfor
pure subroutine new_variable_(var, name, data_type, length, dims)
  type(variable_type), intent(inout) :: var
  character(len=*), intent(in) :: name
  integer(int32), intent(in) :: data_type
  integer(int64), intent(in) :: length
  type(dimension_type), intent(in) :: dims(:)

  var%name = trim(adjustl(name))
  var%data_type = data_type
  var%length = length
  var%dimensions = dims
end subroutine new_variable_

end submodule submodule_variable_constructor