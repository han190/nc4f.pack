#: include 'common.fypp'
submodule(nc4f_data_struct) nc4f_data_struct_arith
implicit none (type, external)
contains

#: for O, N in zip(ops, op_names)
!> Element-wise operator `${O}$` for two `variable_type` values.
module function ${N}$_vars(x, y) result(res)
  !> Left operand variable.
  type(variable_type), target, intent(in) :: x, y
  !> Resulting variable containing the element-wise result.
  type(variable_type), target :: res

  if (any(x%dims /= y%dims)) &
    & error stop "[add_vars] Unequal dims."
  if (x%dtype /= y%dtype) &
    & error stop "[add_vars] Unequal data type."

  call allocate_memory(res, mold=x)
  if (res%len == 0) return
  select case (x%dtype)
    #: for D, T, K in zip(dtypes, types, kinds)
  case (${D}$)
    block
      !> Typed pointer view for operands and result.
      ${T}$(${K}$), pointer :: xp(:), yp(:), resp(:)

      call extract(x, xp)
      call extract(y, yp)
      call extract(res, resp)
      resp = xp ${O}$ yp
    end block
    #: endfor
  end select
end function ${N}$_vars

#: for D1, T1, K1 in zip(dtypes, types, kinds)
!> Operator `${O}$` between a `variable_type` and a scalar `${T1}$`.
module function ${N}$_var_${K1}$(x, y) result(res)
  !> Variable left operand.
  type(variable_type), target, intent(in) :: x
  !> Scalar right operand of type `${T1}$` kind `${K1}$`.
  ${T1}$(${K1}$), intent(in) :: y
  !> Resulting variable containing the element-wise result.
  type(variable_type), target :: res
  !> Pointer view of the variable's data.
  ${T1}$(${K1}$), pointer :: xp(:), resp(:)

  if (x%dtype /= ${D1}$) error stop &
    & "[${N}$_var_${K1}$] typeof(x) /= typeof(y)."

  call allocate_memory(res, mold=x)
  if (res%len == 0) return
  call extract(x, xp)
  call extract(res, resp)
  resp = xp ${O}$ y
end function ${N}$_var_${K1}$

!> Operator `${O}$` between a scalar `${T1}$` and a `variable_type`.
module function ${N}$_${K1}$_var(x, y) result(res)
  !> Scalar left operand of type `${T1}$` kind `${K1}$`.
  ${T1}$(${K1}$), intent(in) :: x
  !> Variable right operand.
  type(variable_type), target, intent(in) :: y
  !> Resulting variable containing the element-wise result.
  type(variable_type), target :: res
  !> Pointer view of the variable's data.
  ${T1}$(${K1}$), pointer :: yp(:), resp(:)

  if (y%dtype /= ${D1}$) error stop &
    & "[${N}$_var_${K1}$] typeof(x) /= typeof(y)."

  call allocate_memory(res, mold=y)
  if (res%len == 0) return
  call extract(y, yp)
  call extract(res, resp)
  resp = x ${O}$ yp
end function ${N}$_${K1}$_var${NEWLINE(not (N == 'pow' and K1 == 'read64'))}$
#: endfor
#: endfor

module function sum_vars(vars) result(s)
  type(variable_type), intent(in) :: vars(:)
  type(variable_type) :: s
  integer :: i, n

  !> Assuming vars share same dimensions and type.
  n = size(vars)
  select case (n)
  case (1)
    s = vars(1)
  case (2:)
    do i = 2, n
      if (any(vars(1)%dims /= vars(i)%dims)) &
        & error stop "[sum_vars] Invalid dims."
      if (vars(1)%dtype /= vars(i)%dtype) &
        & error stop "[sum_vars] Invalid type."
    end do

    call allocate_memory(s, mold=vars(1))
    if (s%len == 0) return
    select case (s%dtype)
      #: for D, T, K in zip(dtypes, types, kinds)
    case (${D}$)
      block
        ${T}$(${K}$), pointer :: s_ptr(:), v_ptr(:)

        call extract(s, s_ptr)
        s_ptr = 0
        do i = 1, n
          call extract(vars(i), v_ptr)
          s_ptr = s_ptr + v_ptr
        end do
      end block
      #: endfor
    case default
      error stop "[sum_vars] Invalid type."
    end select
  case default
    error stop "[sum_vars] Invalid size."
  end select
end function sum_vars

end submodule nc4f_data_struct_arith
