#! Conditionally create a new line.
#: def NEWLINE(cond=None)
  #: if cond is None or cond
    $: "\n"
  #: endif
#: enddef

#! Generate colons for array.
#: def COLONS(R)
:#{for _ in range(R - 1)}#, :#{endfor}#
#: enddef

#! Generate one-based first-element indices for an array.
#: def ONES(R)
${', '.join(['1'] * R)}$
#: enddef

#: endmute
