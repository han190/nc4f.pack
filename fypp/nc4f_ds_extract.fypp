#: include 'common.fypp'
submodule(nc4f_ds) nc4f_ds_extract
implicit none (type, external)
contains

#: for D, T, K in zip(dtypes + ['CHAR_TYPE'], types + ['char'], kinds + ['char'])
  #: for R in ('vector', 'scalar')
module subroutine extract_att_${K}$_${R}$(att, ptr)
  !! Extract attribute data of kind `${K}$` as a `${R}$` from `att`.
  type(attribute_type), target, intent(in) :: att
  !! Source attribute to extract from.
      #: if K == 'char' and R == 'scalar'
  character(len=:), pointer, intent(out) :: ptr
  !! Output scalar string (allocated by caller via pointer assignment).
      #: elif K == 'char' and R == 'vector'
  character, pointer, intent(out) :: ptr(:)
  !! Output vector of characters.
      #: elif R == 'vector'
  ${T}$(${K}$), pointer, intent(out) :: ptr(:)
  !! Output vector of `${T}$` of kind `${K}$`.
      #: elif R == 'scalar'
  ${T}$(${K}$), pointer, intent(out) :: ptr
  !! Output scalar `${T}$` of kind `${K}$`.
      #: endif
      #: if (K == 'char' and R == 'scalar')
  character, pointer :: ptrs(:)
  !! Temporary vector of characters used for scalar extraction.
  integer :: i
  !! Loop index for copying characters.
      #: else
  type(c_ptr) :: cptr
  !! C pointer used to map the attribute buffer into the Fortran pointer.
      #: endif

  call validate(att, ${D}$, "[extract_att_${K}$_${R}$]")
      #: if R == 'scalar' and T != 'char'
  if (att%len /= 1) error stop &
    & "[extract_att_${K}$_scalar] Not a scalar."
      #: endif
      #: if K == 'char' and R == 'scalar'
  allocate (character(len=att%len) :: ptr)
  if (att%len == 0) return
  call extract_att_char_vector(att, ptrs)
  do i = 1, size(ptrs)
    ptr(i:i) = ptrs(i)
  end do
      #: elif R == 'vector'
  if (att%len == 0) then
    nullify (ptr)
    return
  end if
  cptr = buffer2cptr(att)
  call c_f_pointer(cptr, ptr, [att%len])
      #: elif R == 'scalar'
  cptr = buffer2cptr(att)
  call c_f_pointer(cptr, ptr)
      #: endif
end subroutine extract_att_${K}$_${R}$${NEWLINE(not (K == 'char' and R == 'scalar'))}$
  #: endfor
#: endfor

#: for D, T, K in zip(dtypes, types, kinds)
  #: for R in range(1, MAX_RANK+1)
module subroutine extract_var_${K}$_${R}$d(var, ptr)
  !! Extract variable data of kind `${K}$` and rank ${R}$ into `ptr`.
  type(variable_type), target, intent(in) :: var
  !! Source variable whose buffer will be mapped.
  ${T}$(${K}$), pointer, intent(out) :: ptr(${COLONS(R)}$)
  !! Output pointer with matching element kind and rank.
  type(c_ptr) :: cptr
  !! C pointer used to map the variable buffer into the Fortran pointer.

  call validate(var, ${D}$, ${R}$, "[extract_var_${K}$_${R}$d]")
  if (var%len == 0) then
    nullify (ptr)
    return
  end if

  cptr = buffer2cptr(var)
      #: if R == 1
  call c_f_pointer(cptr, ptr, [var%len])
      #: else
  call c_f_pointer(cptr, ptr, shape(var))
      #: endif
end subroutine extract_var_${K}$_${R}$d${NEWLINE(not (K == 'real64' and R == MAX_RANK))}$
  #: endfor
#: endfor

#: for R in range(1, MAX_RANK+1)
module subroutine extract_var_char_${R}$d(var, ptr)
  !! Extract character variable data of rank ${R}$ into `ptr`.
  type(variable_type), target, intent(in) :: var
  !! Source variable whose buffer will be mapped.
  character, pointer, intent(out) :: ptr(${COLONS(R)}$)
  !! Output pointer with matching rank.
  type(c_ptr) :: cptr
  !! C pointer used to map the variable buffer into the Fortran pointer.

  call validate(var, CHAR_TYPE, ${R}$, "[extract_var_char_${R}$d]")
  if (var%len == 0) then
    nullify (ptr)
    return
  end if

  cptr = buffer2cptr(var)
    #: if R == 1
  call c_f_pointer(cptr, ptr, [var%len])
    #: else
  call c_f_pointer(cptr, ptr, shape(var))
    #: endif
end subroutine extract_var_char_${R}$d${NEWLINE(not (R == MAX_RANK))}$
#: endfor

pure function dtype2kind(dtype) result(kind_val)
  !! Map a netCDF integer type code to a Fortran `kind` value.
  integer(data_type), intent(in) :: dtype
  !! NetCDF integer type code (NC_* constant) to map.
  integer :: kind_val
  !! Returned Fortran `kind` corresponding to the netCDF type.

  select case (dtype)
  case (NAT_TYPE)
    error stop "[dtype2kind] Not a type."
  case (BYTE_TYPE)
    kind_val = kind(0_int8)
  case (CHAR_TYPE)
    kind_val = kind("")
  case (SHORT_TYPE)
    kind_val = kind(0_int16)
  case (INT_TYPE)
    kind_val = kind(0_int32)
  case (FLOAT_TYPE)
    kind_val = kind(0._real32)
  case (DOUBLE_TYPE)
    kind_val = kind(0._real64)
  case (INT64_TYPE)
    kind_val = kind(0._int64)
  case default
    error stop "[dtype2kind] Unsupported type."
  end select
end function dtype2kind

end submodule nc4f_ds_extract
