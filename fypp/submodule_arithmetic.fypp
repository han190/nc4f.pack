#: include 'common.fypp'
submodule(module_netcdf) submodule_arithmetic
implicit none (type, external)
contains

#: for O, N in zip(ops, op_names)
module function ${N}$_vars(x, y) result(res)
  type(variable_type), target, intent(in) :: x, y
  type(variable_type), target :: res

  if (any(x%dims /= y%dims)) &
    & error stop "[add_vars] Unequal dims."
  if (x%dtype /= y%dtype) &
    & error stop "[add_vars] Unequal data type."

  call allocate_variable(res, mold=x)
  select case (x%dtype)
  #: for C, T, K in zip(nc_types, types, kinds)
  case (${C}$)
    block
      ${T}$(${K}$), pointer :: xp(:), yp(:), resp(:)
      type(c_ptr) :: cptr

      cptr = c_loc(res%buffer(1))
      call c_f_pointer(cptr, resp, [res%len])
      cptr = c_loc(x%buffer(1))
      call c_f_pointer(cptr, xp, [x%len])
      cptr = c_loc(y%buffer(1))
      call c_f_pointer(cptr, yp, [y%len])
      resp = xp ${O}$ yp
      nullify (xp, yp, resp)
    end block
  #: endfor
  end select
end function ${N}$_vars${newline}$
#: for C1, T1, K1 in zip(nc_types, types, kinds)
module function ${N}$_var_${K1}$(x, y) result(res)
  type(variable_type), target, intent(in) :: x
  ${T1}$(${K1}$), intent(in) :: y
  type(variable_type), target :: res

  select case (x%dtype)
  #: for C2, T2, K2 in zip(nc_types, types, kinds)
  case (${C2}$)
    block
      ${T2}$(${K2}$), pointer :: xp(:)
      ${MERGE_TYPE(C1,C2,types)}$(${MERGE_TYPE(C1,C2,kinds)}$), pointer :: resp(:)
      type(c_ptr) :: cptr
      integer(int32) :: dtype

      dtype = ${MERGE_TYPE(C1,C2,nc_types)}$
      if (allocated(x%atts)) then
        call allocate_variable(res, x%name, &
          & dtype, x%len, x%dims, x%atts)
      else
        call allocate_variable(res, x%name, &
          & dtype, x%len, x%dims)
      end if

      cptr = c_loc(res%buffer(1))
      call c_f_pointer(cptr, resp, [res%len])
      cptr = c_loc(x%buffer(1))
      call c_f_pointer(cptr, xp, [x%len])

      resp = xp ${O}$ y
      nullify (xp, resp)
    end block
  #: endfor
  end select
end function ${N}$_var_${K1}$${newline}$
module function ${N}$_${K1}$_var(x, y) result(res)
  ${T1}$(${K1}$), intent(in) :: x
  type(variable_type), target, intent(in) :: y
  type(variable_type), target :: res

  select case (y%dtype)
  #: for C2, T2, K2 in zip(nc_types, types, kinds)
  case (${C2}$)
    block
      ${T2}$(${K2}$), pointer :: yp(:)
      ${MERGE_TYPE(C1,C2,types)}$(${MERGE_TYPE(C1,C2,kinds)}$), pointer :: resp(:)
      type(c_ptr) :: cptr
      integer(int32) :: dtype

      dtype = ${MERGE_TYPE(C1,C2,nc_types)}$
      if (allocated(y%atts)) then
        call allocate_variable(res, y%name, &
          & dtype, y%len, y%dims, y%atts)
      else
        call allocate_variable(res, y%name, &
          & dtype, y%len, y%dims)
      end if

      cptr = c_loc(res%buffer(1))
      call c_f_pointer(cptr, resp, [res%len])
      cptr = c_loc(y%buffer(1))
      call c_f_pointer(cptr, yp, [y%len])

      resp = x ${O}$ yp
      nullify (yp, resp)
    end block
  #: endfor
  end select
end function ${N}$_${K1}$_var${newline}$
#: endfor
#: endfor
module function sum_vars(vars) result(s)
  type(variable_type), intent(in) :: vars(:)
  type(variable_type) :: s
  integer :: i

  select case (size(vars))
  case (1)
    s = vars(1)
  case (2)
    s = vars(1) + vars(2)
  case (3:)
    s = vars(1)
    do i = 2, size(vars)
      s = s + vars(i)
    end do
  case default
    error stop "[sum_vars] Invalid size."
  end select
end function sum_vars

end submodule submodule_arithmetic${newline}$